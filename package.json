{
  "name": "benchline",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist/",
    "native/",
    "server/",
    "shared/",
    "src/",
    "scripts/build-native.mjs",
    "scripts/check-firmware-artifacts.mjs",
    "scripts/check-private-candidate.mjs",
    "scripts/check-roadmap.mjs",
    "scripts/install-plugin.mjs",
    "scripts/launch.mjs",
    "scripts/launch-neutral.mjs",
    "scripts/launcher-settings.mjs",
    "scripts/license-inventory.mjs",
    "scripts/migration-plan.mjs",
    "scripts/python-license-inventory.py",
    "scripts/review-check.mjs",
    "docs/benchline/release/",
    "docs/benchline/application/",
    "docs/benchline/firmware/",
    "docs/benchline/integration/",
    "docs/benchline/licenses/",
    "docs/benchline/LOCAL_RUNTIME.md",
    "docs/benchline/mechanical/",
    "docs/benchline/MIGRATION.md",
    "docs/benchline/physical/",
    ".env.example",
    "index.html",
    "vite.config.js",
    "README.md",
    "package-lock.json",
    "npm-shrinkwrap.json",
    "THIRD_PARTY.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:provider-isolation": "node tests/fixtures/provider-isolation-probe.mjs",
    "test:provider-code-mode": "node tests/fixtures/provider-code-mode-probe.mjs --host-enabled --exercise",
    "test:provider-code-mode-isolation": "node tests/fixtures/provider-isolation-probe.mjs --code-mode",
    "test:provider-model-profile": "node tests/fixtures/provider-model-profile-probe.mjs",
    "test:provider-native-read": "node tests/fixtures/provider-native-read-probe.mjs",
    "test:native-binding-http": "node tests/fixtures/native-binding-http-probe.mjs",
    "review:check": "node scripts/review-check.mjs",
    "licenses:inventory": "node scripts/license-inventory.mjs --write",
    "licenses:check": "node scripts/license-inventory.mjs",
    "licenses:release-check": "node scripts/license-inventory.mjs --release",
    "install-plugin": "node scripts/install-plugin.mjs",
    "build:native": "node scripts/build-native.mjs",
    "firmware:check-artifacts": "node scripts/check-firmware-artifacts.mjs",
    "candidate:check": "node scripts/check-private-candidate.mjs",
    "launch": "node scripts/launch-neutral.mjs",
    "launch:project": "node scripts/launch.mjs",
    "migration:plan": "node scripts/migration-plan.mjs",
    "roadmap:check": "node scripts/check-roadmap.mjs"
  },
  "dependencies": {
    "@a2ui/react": "0.11.0",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "10.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vite": "^6.4.1"
  },
  "overrides": {
    "dompurify": "3.4.14"
  }
}
