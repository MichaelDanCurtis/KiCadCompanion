# Documentation only: export these values in your shell; no automatic dotenv loading.
# BENCHLINE_WORKSPACE=/path/to/your/pcb-project
# BENCHLINE_BOARDS_DIR=hardware
# BENCHLINE_PORT=4318
# BENCHLINE_STATE_DIR=/path/to/private/local-state
# BENCHLINE_AUTOCONNECT=0
# CODEX_BIN=/path/to/codex
# KONNECT_BIN=/path/to/konnect
# Explicit private dispatcher opt-in; requires the exact locally qualified
# binaries and an available selected model. No implicit model/runtime fallback.
# This does not enable the legacy agent launcher or unqualified CAD operations.
# BENCHLINE_PROVIDER_RUNTIME=local-dispatch-v1
# BENCHLINE_PROVIDER_MODEL=your-explicit-model-id
# Optional reviewed native pin/scope record. Currently only the disposable
# qualified model-assignment scope is supported, not arbitrary customer boards.
# BENCHLINE_NATIVE_MODEL_REGISTRATION=/path/to/host-native-binding.json
# Optional exact public-document and read-only DigiKey registrations.
# These are host configuration paths, not credentials. See docs/benchline.
# BENCHLINE_MODULE_SOURCES=/path/to/host-module-sources.json
# BENCHLINE_DIGIKEY=/path/to/host-digikey-config.json
# Optional paired, host-owned action connection. Live reads refuse wrong editor,
# disconnection or file fallback. Does not enable native writes or an AI provider.
# BENCHLINE_KONNECT_CONFIG=/path/to/isolated-konnect.toml
# BENCHLINE_KICAD_IPC=ipc:///tmp/kicad/selected-editor.sock
# BENCHLINE_PYTHON=/path/to/python-with-kipy
# KICAD_APP=/path/to/KiCad.app
# KICAD_CLI=/path/to/kicad-cli
# KICAD_PCB_EDITOR=/path/to/PCB-Editor.app
# KICAD_PYTHON=/path/to/kicad-python
# KICAD_3DMODEL_DIR=/path/to/3dmodels
# COMPANION_KICAD_CONFIG_DIR=/path/to/kicad/10.0
