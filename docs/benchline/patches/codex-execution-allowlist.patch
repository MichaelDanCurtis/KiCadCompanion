+use crate::config::ToolRegistryConfig;
+use crate::tools::registry::ToolRegistry;
+
+pub(super) fn restrict_registry(config: &ToolRegistryConfig, registry: &mut ToolRegistry) {
+    let Some(allowlist) = config.execution_allowlist.as_ref() else {
+        return;
+    };
+    let rejected = registry
+        .entries()
+        .map(|tool| tool.runtime.tool_name())
+        .filter(|name| !codex_tools::tool_execution_allowed(Some(allowlist), name))
+        .collect::<Vec<_>>();
+    for name in rejected {
+        registry.remove(&name);
+    }
+}
