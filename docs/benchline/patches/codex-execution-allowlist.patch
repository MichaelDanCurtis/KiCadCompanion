+use std::collections::BTreeMap;
+
+use codex_protocol::ToolName;
+
+/// Tests an exact execution allowlist, independently of model-visible exposure.
+/// Missing configuration preserves upstream behavior; an empty map denies all.
+/// Plain names use the canonical functions namespace. No wildcards or flattened
+/// aliases are interpreted, so permission cannot cross namespace boundaries.
+pub fn tool_execution_allowed(
+    allowlist: Option<&BTreeMap<String, Vec<String>>>,
+    tool: &ToolName,
+) -> bool {
+    let Some(allowlist) = allowlist else {
+        return true;
+    };
+    let tool = tool.clone().with_default_namespace();
+    tool.namespace
+        .as_ref()
+        .and_then(|namespace| allowlist.get(namespace))
+        .is_some_and(|names| names.contains(&tool.name))
+}
+
