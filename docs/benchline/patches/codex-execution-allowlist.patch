+#[tokio::test]
+async fn execution_allowlist_denies_retained_handlers_before_lifecycle_for_both_sources()
+-> anyhow::Result<()> {
+    let (mut session, mut turn) = crate::session::tests::make_session_and_context().await;
+    Arc::make_mut(&mut turn.config)
+        .tool_registry
+        .execution_allowlist = Some(BTreeMap::new());
+    let records = Arc::new(std::sync::Mutex::new(Vec::new()));
+    let mut builder = codex_extension_api::ExtensionRegistryBuilder::<crate::config::Config>::new();
+    builder.tool_lifecycle_contributor(Arc::new(ToolLifecycleRecorder {
+        records: Arc::clone(&records),
+    }));
+    session.services.extensions = Arc::new(builder.build());
+    let tool_name = codex_tools::ToolName::plain("must_not_execute");
+    // Deliberately leave the denied handler registered, bypassing spec pruning.
+    let registry = ToolRegistry::from_tools([Arc::new(LifecycleTestHandler {
+        tool_name: tool_name.clone(),
+        result: LifecycleTestResult::Ok { success: true },
+    }) as Arc<dyn CoreToolRuntime>]);
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    for source in [
+        crate::tools::context::ToolCallSource::Direct,
+        crate::tools::context::ToolCallSource::CodeMode {
+            cell_id: "cell".to_string(),
+            runtime_tool_call_id: "nested".to_string(),
+        },
+    ] {
+        let mut invocation = test_invocation(
+            Arc::clone(&session),
+            Arc::clone(&turn),
+            "denied-call",
+            tool_name.clone(),
+        );
+        invocation.source = source;
+        let error = match registry
+            .dispatch_any_with_terminal_outcome(invocation, /*terminal_outcome_reached*/ None)
+            .await
+        {
+            Ok(_) => panic!("retained forbidden handler executed"),
+            Err(error) => error,
+        };
+        assert_eq!(
+            error.to_string(),
+            "tool execution blocked by the configured execution allowlist"
+        );
+    }
+    assert_eq!(*records.lock().expect("lifecycle records"), Vec::new());
+    Ok(())
+}
