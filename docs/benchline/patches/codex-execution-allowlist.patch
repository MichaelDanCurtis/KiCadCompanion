@@ -0,0 +1,33 @@
+use super::tool_execution_allowed;
+use codex_protocol::ToolName;
+use pretty_assertions::assert_eq;
+use std::collections::BTreeMap;
+
+#[test]
+fn exact_allowlist_preserves_namespace_identity_and_denies_omitted_names() {
+    let allowlist = BTreeMap::from([
+        ("functions".to_string(), vec!["read".to_string()]),
+        ("clock".to_string(), vec!["curr_time".to_string()]),
+    ]);
+    let cases = [
+        (ToolName::plain("read"), true),
+        (ToolName::namespaced("functions", "read"), true),
+        (ToolName::namespaced("", "read"), true),
+        (ToolName::namespaced("clock", "curr_time"), true),
+        (ToolName::namespaced("clock", "read"), false),
+        (ToolName::plain("clock__curr_time"), false),
+        (ToolName::plain("exec_command"), false),
+        (ToolName::plain("*"), false),
+    ];
+    for (tool, expected) in cases {
+        assert_eq!(tool_execution_allowed(Some(&allowlist), &tool), expected);
+    }
+    assert_eq!(
+        tool_execution_allowed(/*allowlist*/ None, &ToolName::plain("read")),
+        true
+    );
+    assert_eq!(
+        tool_execution_allowed(Some(&BTreeMap::new()), &ToolName::plain("read")),
+        false
+    );
+}
