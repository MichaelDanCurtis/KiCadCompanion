+use std::collections::BTreeMap;
+
+use anyhow::Result;
+use codex_features::Feature;
+use codex_protocol::config_types::WebSearchMode;
+use core_test_support::responses;
+use core_test_support::responses::ev_completed;
+use core_test_support::responses::ev_function_call_with_namespace;
+use core_test_support::responses::ev_response_created;
+use core_test_support::responses::sse;
+use core_test_support::test_codex::test_codex;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use test_case::test_case;
+
+// The synthetic model intentionally emits a call even when its schema is absent.
+// This exercises the actual model-to-dispatch path, not just a policy predicate.
+#[test_case("clock", "curr_time", true; "admitted_exact_namespace")]
+#[test_case("clock", "curr_time", false; "registered_but_denied")]
+#[test_case("functions", "exec_command", false; "forged_direct_shell")]
+#[test_case("functions", "apply_patch", false; "forged_direct_file_edit")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn execution_allowlist_controls_forged_direct_calls(
+    namespace: &str,
+    name: &str,
+    allowed: bool,
+) -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let responses = responses::mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("resp-1"),
+                ev_function_call_with_namespace("call-1", namespace, name, "{}"),
+                ev_completed("resp-1"),
+            ]),
+            sse(vec![ev_response_created("resp-2"), ev_completed("resp-2")]),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_config(move |config| {
+            config
+                .features
+                .enable(Feature::CurrentTimeReminder)
+                .expect("clock registration should be available");
+            config.tool_registry.execution_allowlist = Some(if allowed {
+                BTreeMap::from([("clock".to_string(), vec!["curr_time".to_string()])])
+            } else {
+                BTreeMap::new()
+            });
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("Exercise only the test tool call").await?;
+    let requests = responses.requests();
+    assert_eq!(requests.len(), 2);
+    assert_eq!(
+        requests[0].tool_by_name("clock", "curr_time").is_some(),
+        allowed
+    );
+    let output = requests[1]
+        .function_call_output_text("call-1")
+        .expect("every forged call must receive a result");
+    if allowed {
+        assert!(output.contains("UTC"), "clock should execute: {output}");
+    } else {
+        assert_eq!(
+            output,
+            "tool execution blocked by the configured execution allowlist"
+        );
+    }
+    Ok(())
+}
+
+// Late-added Code Mode controls and provider-hosted search must not restore
+// authority after the initial registry has been pruned.
+#[test_case("exec"; "forged_code_mode_exec")]
+#[test_case("wait"; "forged_code_mode_wait")]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn execution_allowlist_empty_removes_code_mode_and_hosted_tools(name: &str) -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let responses = responses::mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("resp-1"),
+                ev_function_call_with_namespace("call-1", "functions", name, "{}"),
+                ev_completed("resp-1"),
+            ]),
+            sse(vec![ev_response_created("resp-2"), ev_completed("resp-2")]),
+        ],
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| {
+            config
+                .features
+                .enable(Feature::CodeModeOnly)
+                .expect("Code Mode available");
+            config
+                .web_search_mode
+                .set(WebSearchMode::Live)
+                .expect("search available");
+            config.tool_registry.execution_allowlist = Some(BTreeMap::new());
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn("Exercise the test call despite its omitted schema")
+        .await?;
+    let requests = responses.requests();
+    assert_eq!(requests.len(), 2);
+    assert_eq!(requests[0].body_json()["tools"], json!([]));
+    assert_eq!(
+        requests[1].function_call_output_text("call-1"),
+        Some("tool execution blocked by the configured execution allowlist".to_string())
+    );
+    Ok(())
+}
